# Copy to .env and fill in. The Python tools in tools/ read these from the
# environment; .env is gitignored and must stay that way.
#
#   set -a; source .env; set +a
#
# Spotify Developer Dashboard -> your app -> Settings.
# Client Credentials flow: no user login, used for GET /tracks/{id}.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Only needed for `yt_playlist.py --playlist`, which reads a playlist you own.
# Must match a Redirect URI registered on the same Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
